# Copy to a protected local file and replace every placeholder before startup.
# This example contains no usable credential or signing key.
DATABASE_URL=postgresql://ai_auth:REPLACE_WITH_LOCAL_TEST_PASSWORD@database:5432/ai_auth
STORAGE_PATH=/var/lib/ai-authentication/evidence
SIGNING_KEY_PROVIDER=local_test
AUDIT_CONFIG=hash_chain_v1
LOG_LEVEL=INFO

# Local acceptance-test placeholders only; never commit an institution secret.
POSTGRES_DB=ai_auth
POSTGRES_USER=ai_auth
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_TEST_PASSWORD
MINIO_ROOT_USER=REPLACE_WITH_LOCAL_TEST_USER
MINIO_ROOT_PASSWORD=REPLACE_WITH_LOCAL_TEST_SECRET
