# Required in production. Never commit real secrets.
# Each entry is client_id:secret:role, with role analyst or operator.
APP_ENV=production
APP_API_KEYS=agency-analyst:replace-with-a-long-random-secret:analyst,agency-operator:replace-with-a-different-secret:operator
APP_ALLOWED_ORIGINS=https://reconstructor.example.gov
APP_ALLOWED_HOSTS=reconstructor.example.gov
APP_MAX_UPLOAD_BYTES=10485760
APP_MAX_IMAGE_PIXELS=40000000
APP_REQUESTS_PER_MINUTE=30

# Alternative or additional organisational SSO for API clients. All three are required together.
# Tokens must be RS256-signed and include exp, iat, sub and a roles claim.
APP_OIDC_ISSUER=https://identity.example.gov
APP_OIDC_AUDIENCE=ai-photo-reconstructor
APP_OIDC_JWKS_URL=https://identity.example.gov/.well-known/jwks.json
APP_OIDC_ROLE_CLAIM=roles

# Optional: internal, approved vision-recognition service. Image bytes are sent only to this HTTPS endpoint.
APP_VISION_PROVIDER_URL=https://vision.example.gov/analyze
APP_VISION_PROVIDER_TOKEN=replace-with-provider-service-token

# Optional: internal C2PA verifier. Its valid result is provenance evidence; an AI-detection score is not.
APP_PROVENANCE_PROVIDER_URL=https://provenance.example.gov/verify
APP_PROVENANCE_PROVIDER_TOKEN=replace-with-provenance-service-token
